{
  "name": "kite-agent",
  "version": "0.1.0",
  "description": "A terminal coding agent in TypeScript: multi-provider streaming, permission-gated tools, resumable sessions and an Ink UI.",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "terminal",
    "llm",
    "anthropic",
    "gemini",
    "groq",
    "ink",
    "typescript"
  ],
  "license": "MIT",
  "author": "ChandanKhamitkar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChandanKhamitkar/Kite.git"
  },
  "bugs": {
    "url": "https://github.com/ChandanKhamitkar/Kite/issues"
  },
  "homepage": "https://github.com/ChandanKhamitkar/Kite#readme",
  "type": "module",
  "bin": {
    "kite": "./bin/kite.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "test": "tsx --test \"test/**/*.test.{ts,tsx}\"",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && rm -rf dist && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "dotenv": "^18.0.5",
    "ink": "^8.0.0",
    "openai": "^7.28.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
